# Groq API Key (Required for AI features, get one at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Environment (development, production, etc.)
ENVIRONMENT=development

# Set to True to use mock AI responses without calling Groq
MOCK_AI=False

# --- DATABASE SETTINGS ---
# For Native (localhost database):
WAREHOUSE_DB_URL=postgresql+asyncpg://conduit_user:password@localhost:5432/warehousedb
SOURCE_DB_URL=postgresql+asyncpg://conduit_user:password@localhost:5432/sourcedb

# --- NEO4J SETTINGS ---
# For Native:
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=conduit_graph_2026
